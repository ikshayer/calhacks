{
  "name": "calhacks-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=../../.env src/index.ts",
    "bindings": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../spacetime/spacetimedb -y",
    "typecheck": "tsc --noEmit -p .",
    "video:generate": "tsx --env-file=../../.env scripts/generateVideoCode.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@huggingface/transformers": "^4.3.1",
    "apify-client": "^2.12.0",
    "spacetimedb": "2.13.*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2"
  }
}
