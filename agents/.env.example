# agents/.env — never commit the filled-in version.
# Values also fall back to the repo-root .env, which the Node worker uses.

# --- Fetch.ai -----------------------------------------------------------
# Secret phrases that fix each agent's address. Change them and the address
# changes, which means re-registering on Agentverse.
AGENT_SEED_ORCHESTRATOR=
AGENT_SEED_INGEST=
AGENT_SEED_SIMULATION=
# agentverse.ai -> Profile -> API Keys. Only needed for scripted registration;
# the Agent Inspector link printed at startup is the simpler route.
AGENTVERSE_API_KEY=
AGENT_HANDLE=reel-rehearsal
BUREAU_PORT=8100

# --- SpacetimeDB --------------------------------------------------------
STDB_URL=https://maincloud.spacetimedb.com
STDB_DATABASE=calhacks-wwif0
# MUST be the identity token of the user that owns PROFILE_ID and its videos.
# start_run calls requireOwner, so an anonymous identity is rejected.
# Get it from the browser app's stored session, or from `spacetime login show`
# for the identity that published the demo data.
STDB_TOKEN=

# --- Apify --------------------------------------------------------------
APIFY_TOKEN=
APIFY_REEL_ACTOR=apify/instagram-reel-scraper

# --- The browser app ----------------------------------------------------
# Used to build the "watch the replay" link: <ISLAND_URL>/workspace?run=<id>
ISLAND_URL=http://localhost:5173

# --- Demo data ----------------------------------------------------------
# The profile the agent acts for, and the video it falls back to.
PROFILE_ID=gg
CAMPAIGN_ID=c1
FALLBACK_VIDEO_ID=1

# --- Tuning -------------------------------------------------------------
RUN_TIMEOUT_SECONDS=300
POLL_SECONDS=1.5
WORKER_TIMEOUT_SECONDS=420
