ANTHROPIC_API_KEY=
JEV_API_KEY=
APIFY_TOKEN=
# SpacetimeDB: ws://127.0.0.1:3000 for `spacetime start`, wss://maincloud.spacetimedb.com for Maincloud
SPACETIME_HOST=
SPACETIME_DB=
# Shared secret the worker presents to register_worker; set it once with set_worker_secret
WORKER_SECRET=
# Comma-separated niche accounts scraped for reference reels, e.g. feedingamerica,localfarm
REFERENCE_ACCOUNTS=
REELS_PER_ACCOUNT=10
# Optional: folder for demo:<file> video sources (default frontend/public/demo)
DEMO_VIDEOS_DIR=
